{
  "name": "backend",
  "description": "Notes-app backend project",
  "version": "1.0.0",
  "license": "MIT",
  "author": {
    "name": "-_YoYo178_-"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YoYo178/Notes-app"
  },
  "scripts": {
    "build": "pnpm run lint && tsc --build tsconfig.prod.json",
    "clean-install": "rm -rf ./node_modules && rm -r pnpm-lock.yaml && pnpm install",
    "dev": "cross-env NODE_ENV=development node --env-file=./config/.env.development -r ts-node/register ./src",
    "dev:hot": "cross-env NODE_ENV=development nodemon --exec \"node --env-file=./config/.env.development -r ts-node/register ./src\" --watch ./src --ext .ts",
    "lint": "eslint",
    "start": "cross-env NODE_ENV=production node --env-file=./config/.env.production -r module-alias/register ./dist",
    "phantom-start": "cross-env NODE_ENV=production node -r module-alias/register ./dist",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "inserturlparams": "^2.0.5",
    "jet-env": "^1.1.6",
    "jet-logger": "^2.2.3",
    "jet-paths": "^2.0.1",
    "jet-schema": "^1.4.3",
    "jet-validators": "^2.2.6",
    "jsonfile": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "uuid": "^13.0.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@swc/core": "1.15.10",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/find": "^0.2.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jasmine": "^6.0.0",
    "@types/jsonfile": "^6.1.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.10",
    "@types/nodemailer": "^7.0.5",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.10",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-n": "^17.23.2",
    "find": "^0.3.0",
    "fs-extra": "^11.3.3",
    "jasmine": "^6.0.0",
    "jiti": "^2.6.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
